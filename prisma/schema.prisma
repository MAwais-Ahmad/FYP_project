datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  STUDENT
  TEACHER
  SUPERVISOR
  ADMIN
}

model User {
  id                 String          @id @default(uuid())
  email              String          @unique
  passwordHash       String
  name               String
  role               Role            @default(USER)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  resetToken         String?         @unique
  resetTokenExpires  DateTime?

  records      Record[]        // Solo test results
  sessions     Session[]       // Sessions this user hosts
  memberships  SessionMember[] // Sessions this user joined
}

model Session {
  id          String          @id @default(uuid())
  code        String          @unique   // 6-char join code like "A3X7K2"
  title       String                    // e.g. "CS301 Midterm Assessment"
  hostId      String
  host        User            @relation(fields: [hostId], references: [id])
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())

  // Host-authored assessment every participant takes. Null until the host
  // creates it (participants "wait" until then). Shape:
  //   { kind: 'custom-exam', exam: { examTitle, totalMarks, questions:[…with answer key] } }
  //   { kind: 'ai-scenario', scenario: {…}, questions: [Question[]], difficultyLevel }
  assessment  Json?

  members     SessionMember[]
}

model SessionMember {
  id          String   @id @default(uuid())
  sessionId   String
  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  joinedAt    DateTime @default(now())
  recordId    String?  // Links to the Record created when they complete the assessment

  @@unique([sessionId, userId])  // One membership per session
}

model Record {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date                DateTime @default(now())
  scenariosCompleted  Int

  // Classification
  primaryCategory     String
  primaryName         String
  primaryEmoji        String
  primaryConfidence   Float
  secondaryCategory   String?
  secondaryName       String?

  // Headline metrics
  confidence          Float
  performanceScore    Float
  avgPerformanceScore Float
  accuracyScore       Float
  avgResponseTime     Float
  decisionStyle       String

  // Nested structures stored as JSONB
  cognitive           Json     // CognitiveFeatures
  overall             Json     // OverallMetrics
  scenarioResults     Json     // ScenarioResult[]
  vark                Json?    // VARK scores: { visual: Float, auditory: Float, readWrite: Float, kinesthetic: Float }

  createdAt           DateTime @default(now())

}
